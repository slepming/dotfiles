configuration {
  modi: "drun,run,window";
  show-icons: true;
  display-drun: "";
  display-run: "";
  display-window: "";
  drun-display-format: "{name}";
  font: "BigBlueTerm437NerdFontMono 12";
}

@theme "~/.config/rofi/theme.rasi"

window {
  width: 45%;
  border-radius: 16px;
  border: 1px;
  border-color: @border-color;
  background-color: @bg;
  padding: 24px;
  transparency: "real";
}

mainbox {
  background-color: transparent;
  spacing: 20px;
}

inputbar {
  background-color: @input-bg; 
  border-radius: 12px;
  padding: 14px 18px;
  spacing: 12px;
  children: [ prompt, entry ];
  border: 1px;
  border-color: @input-border;
}

prompt {
  text-color: @fg-alt;
  background-color: transparent;
  vertical-align: 0.5;
  font: "BigBlueTerm437NerdFontMono  14";
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder: "Search applications...";
  placeholder-color: @fg-alt;
  vertical-align: 0.5;
  blink: true;
}

listview {
  background-color: transparent;
  columns: 2;
  lines: 8;
  spacing: 10px;
  scrollbar: false;
}

element {
  background-color: transparent;
  text-color: @fg-alt;
  padding: 12px 16px;
  border-radius: 10px;
  spacing: 16px;
  cursor: pointer;
}

element-icon {
  size: 28px;
  background-color: transparent;
  cursor: inherit;
}

element-text {
  text-color: inherit;
  background-color: transparent;
  vertical-align: 0.5;
  cursor: inherit;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color: @fg-alt;
}

element selected.normal {
  background-color: @bg-selected;
  text-color: @fg;
  border: 1px;
  border-color: @select-border;
}

message {
    background-color: transparent;
    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    padding: 12px;
}

textbox {
    background-color: transparent;
    text-color: @fg;
    vertical-align: 0.5;
}
