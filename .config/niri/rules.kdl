workspace "access"
workspace "social"
workspace "term"
workspace "games"
workspace "untitled"
workspace "programming"

// WINDOW RULES

window-rule {
	match app-id="waterfox"
	open-on-workspace "social"
	block-out-from "screen-capture"
}

window-rule {
	match app-id="firefox"
	open-on-workspace "social"
	block-out-from "screen-capture"
}

window-rule {
	match app-id="discord"
	open-on-workspace "untitled"
	block-out-from "screen-capture"
}

window-rule {
	match app-id="org.telegram.desktop"
	open-on-workspace "social"
	block-out-from "screen-capture"
}

window-rule {
	match app-id="Throne"
	open-on-workspace "access"
	block-out-from "screen-capture"
}

window-rule {
	match app-id="chromium"
	open-on-workspace "social"
	block-out-from "screen-capture"
}

window-rule {
  match app-id="Alacritty"
  background-effect {
    blur true
  }
}

window-rule {
    match app-id="viewer"
    open-floating true
    background-effect { 
	blur true 
	xray false
    }
}

// Open the Waterfox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Waterfox (app-id is "waterfox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"net.waterfox.waterfox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Global rules

window-rule {
    match is-window-cast-target=true


    focus-ring {
        width 4

        active-gradient from="#3a3a3a00" to="#ff0000" angle=45 relative-to="workspace-view" in="oklch longer hue"
    }
}

window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}


// LAYER RULES

layer-rule {
	match namespace="widget"
	match at-startup=true
	block-out-from "screen-capture"
}

layer-rule {
	match namespace="rofi"
	match at-startup=true
	block-out-from "screen-capture"
	background-effect {
	  blur true
	  xray false
	}
}
